; Object Rain — first playable foundation. Tested with Godot 4.6.3.
config_version=5

[application]
config/name="Object Rain"
run/main_scene="res://scenes/arena.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Object Rain — physics and first playable combat. Iteration 02."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.055, 0.08, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=9.8

[layer_names]
3d_physics/layer_1="Arena"
3d_physics/layer_2="Player"
3d_physics/layer_3="Objects"
3d_physics/layer_4="Targets"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

